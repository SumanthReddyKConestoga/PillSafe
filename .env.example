# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.1.0
SECRET_KEY=your-256-bit-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pillsafe
POSTGRES_USER=pillsafe_user
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql+asyncpg://pillsafe_user:change_me_in_production@postgres:5432/pillsafe

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── Rate Limiting ─────────────────────────────────────────────────────────────
AUTH_RATE_LIMIT=10/minute

# ── Feature Flags ─────────────────────────────────────────────────────────────
OPENAPI_ENABLED=true
ML_PIPELINE_ENABLED=false     # Set true when Sprint 4 models are ready

# ── LLM (Sprint 6, optional) ─────────────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
